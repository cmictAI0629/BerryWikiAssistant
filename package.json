{
  "name": "berrywiki-assistant",
  "description": "BerryWiki 知识助手：在浏览器里向 OneBerryWiki 知识库提问、剪藏网页、Markdown 速记",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "turndown": "^7.2.4",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/turndown": "^5.0.5",
    "@wxt-dev/module-vue": "^1.0.3",
    "happy-dom": "^15.11.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
